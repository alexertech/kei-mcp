{
  "name": "kei-mcp",
  "displayName": "Kei",
  "version": "1.4.2",
  "description": "Manage Kei projects, boards and work items from Claude Code",
  "author": { "name": "Alex Barrios" },
  "homepage": "https://github.com/alexertech/kei-mcp",
  "repository": "https://github.com/alexertech/kei-mcp",
  "license": "MIT",
  "keywords": ["mcp", "kei", "project-management"],
  "mcpServers": {
    "kei": {
      "command": "npx",
      "args": ["-y", "kei-mcp", "--require-approval"],
      "env": { "KEI_API_KEY": "${user_config.api_key}" }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Kei API key",
      "description": "Generate one in Kei under Settings > API Keys",
      "sensitive": true,
      "required": true
    }
  }
}
